<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_playback_background">

    <ImageView
        android:id="@+id/widget_fallback_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_playback_background"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_theme_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_playback_clip"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/widget_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:id="@+id/widget_album_shell"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_album_background">

            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_album_art"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_neriplayer_round" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_song_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@id/widget_controls"
            android:layout_marginEnd="4dp"
            android:layout_toEndOf="@id/widget_album_shell"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_playback_ready"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_playback_idle_subtitle"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_previous_touch"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_control_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_previous" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_play_pause_touch"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_control_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_play_pause_background"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_primary_control_background" />

                <ImageView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_next_touch"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_control_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_next" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
