    <string name="debug_test_exception_jvm_uncaught_main_desc">Throws an uncaught exception on the main thread and exits the app immediately.</string>
    <string name="debug_test_exception_jvm_uncaught_worker">Uncaught JVM worker-thread crash</string>
    <string name="debug_test_exception_jvm_uncaught_worker_desc">Throws an uncaught exception on a background thread to test the global crash chain.</string>
    <string name="debug_test_exception_anr">Main-thread ANR</string>
    <string name="debug_test_exception_anr_desc">Blocks the main thread for 16 seconds; only the system ANR result can decide whether safe mode opens next time.</string>
    <string name="debug_test_exception_native_sigsegv">Native SIGSEGV crash</string>
    <string name="debug_test_exception_native_sigsegv_desc">Triggers a segmentation fault to verify native crash interception and file logging.</string>
