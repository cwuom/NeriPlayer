<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_compact_clip">

    <ImageView
        android:id="@+id/widget_fallback_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_compact_background"
        android:contentDescription="@null"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_theme_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_compact_clip"
        android:contentDescription="@string/widget_album_art"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_neriplayer_round" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_compact_clip"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_compact_scrim" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/widget_compact_song_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/widget_controls"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="9dp"
            android:paddingTop="7dp"
            android:paddingRight="9dp">

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_playback_ready"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_playback_idle_subtitle"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="3dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_previous_touch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true">

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_control_background"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:scaleType="center"
                    android:src="@drawable/round_skip_previous_24" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_play_pause_touch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true">

                <ImageView
                    android:id="@+id/widget_play_pause_background"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_primary_control_background" />

                <ImageView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:scaleType="center"
                    android:src="@drawable/round_play_arrow_24" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_next_touch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true">

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_control_background"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:scaleType="center"
                    android:src="@drawable/round_skip_next_24" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
