<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_playback_background">

    <ImageView
        android:id="@+id/widget_fallback_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_playback_background"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_theme_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_playback_clip"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:gravity="bottom">

        <RelativeLayout
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:id="@+id/widget_album_shell"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:background="@drawable/widget_album_background">

                <ImageView
                    android:id="@+id/widget_album_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_album_art"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_neriplayer_round" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/widget_song_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/widget_album_shell"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_playback_ready"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_playback_idle_subtitle"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/widget_progress_row"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginBottom="8dp">

            <Chronometer
                android:id="@+id/widget_elapsed"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:text="@string/widget_playback_zero_time"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_toEndOf="@id/widget_elapsed"
                android:layout_toStartOf="@id/widget_duration"
                android:indeterminate="false"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress" />

            <TextView
                android:id="@+id/widget_duration"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical|end"
                android:includeFontPadding="false"
                android:text="@string/widget_playback_zero_time"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_favorite_touch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_control_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_favorite"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_favorite" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_previous_touch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_control_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_previous" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_play_pause_touch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_control_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_play_pause_background"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_primary_control_background" />

                <ImageView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_next_touch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_control_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_next" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_floating_lyrics_touch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_control_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_floating_lyrics"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_lyrics" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
